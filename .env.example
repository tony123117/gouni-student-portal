# Supabase public configuration.
# Use only the public/anonymous key here. Never expose the service role key.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# University backend API base URL (provided when integration is authorized).
VITE_API_BASE_URL=

# Use mock service adapters while the university API is unavailable.
VITE_USE_MOCK_API=true
